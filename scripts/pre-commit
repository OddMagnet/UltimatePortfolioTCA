#!/usr/bin/env bash
set -euo pipefail

# Format staged Swift files with SwiftFormat before committing.
# Uses git-format-staged to only format staged content, preserving unstaged changes.

REPO_ROOT="$(git rev-parse --show-toplevel)"
FORMAT_STAGED="$REPO_ROOT/scripts/git-format-staged"
source "$REPO_ROOT/scripts/tool-paths.sh"

SWIFTFORMAT_BIN="$(resolve_tool swiftformat)"
if [ -z "$SWIFTFORMAT_BIN" ]; then
    echo "warning: SwiftFormat not installed. Skipping pre-commit formatting."
    exit 0
fi

"$FORMAT_STAGED" --formatter "$SWIFTFORMAT_BIN stdin --quiet --stdinpath '{}'" "*.swift"
